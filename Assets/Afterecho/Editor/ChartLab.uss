.lab { padding: 12px; background-color: #152021; color: #e2ede8; flex-grow: 1; }
.heading { font-size: 22px; color: #bae3d8; margin-bottom: 7px; }
.notice { white-space: normal; color: #b7c9c3; margin-bottom: 6px; font-size: 11px; }
.lab-controls { max-height: 440px; flex-shrink: 1; margin-bottom: 6px; }
.toolbar { flex-direction: row; flex-wrap: wrap; margin-bottom: 6px; }
.toolbar > * { margin-right: 7px; margin-bottom: 3px; }
.toolbar .unity-base-field__label { min-width: 54px; }
.toolbar .unity-double-field { width: 165px; }
.toolbar .unity-text-field { min-width: 205px; }
.toolbar .reviewer-field { width: 240px; }
.toolbar .review-reason { flex-grow: 1; min-width: 310px; }
.review-summary { white-space: normal; color: #e9dec0; margin-bottom: 7px; }
.review-waveform { height: 148px; min-height: 148px; background-color: #0b1417; border-width: 1px; border-color: #4b6667; margin-bottom: 4px; }
.range-label { white-space: normal; color: #c7dbd5; font-size: 11px; margin-bottom: 4px; }
.note-row { border-bottom-width: 1px; border-bottom-color: #405356; padding: 7px; margin-bottom: 3px; background-color: #1d2b2e; }
.note-row > .toolbar { margin-bottom: 2px; }
.note-id { min-width: 142px; align-self: center; color: #e5eee9; }
.note-state { width: 74px; align-self: center; color: #f0d39a; }
.review-approved { border-left-width: 3px; border-left-color: #57d9b9; }
.review-rejected { border-left-width: 3px; border-left-color: #ff6978; }
.note-time { width: 170px; }
.note-meta { white-space: normal; color: #dde6e2; margin-bottom: 3px; }
.large-move { color: #ffbe78; -unity-font-style: bold; }
.note-evidence { white-space: normal; color: #afc8c3; font-size: 11px; }
.notes { flex-grow: 1; min-height: 150px; }
.status { white-space: normal; margin-top: 6px; color: #d7e8de; max-height: 90px; }
